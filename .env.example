# Copy to .env and fill in. Never commit the real .env.

# Portkey gateway credentials for the shop assistant.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_MODEL=gpt-5.6-luna

# Signing key for session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is used per process and sessions end when the server restarts.
SESSION_SECRET=your_random_session_secret_here
